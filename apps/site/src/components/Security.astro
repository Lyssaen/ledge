---
import { code, rich, type Catalogue } from '../i18n/index.ts';

interface Props {
  t: Catalogue;
}
const { t } = Astro.props;
const items = ['readOnly', 'local', 'relay', 'pairing', 'hooks'] as const;
---

<section id="securite" class="section">
  <div class="page security__inner">
    <div class="stack security__head">
      <h2 class="title">{t.security.title}</h2>
      <p class="security__lead">{t.security.lead}</p>
    </div>
    <dl class="stack security__list">
      {items.map(item => (
        <div class="security__item">
          <dt>{t.security[item].term}</dt>
          <dd set:html={rich(t.security[item].text, item === 'local' ? { ip: code('127.0.0.1') } : {})} />
        </div>
      ))}
    </dl>
  </div>
</section>
