{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ledge Desktop",
  "version": "0.20.0",
  "identifier": "be.paradow.ledge.desktop",
  "build": { "beforeDevCommand": "pnpm dev:all", "devUrl": "http://localhost:1421", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "label": "main", "title": "Ledge Desktop", "width": 1280, "height": 800, "minWidth": 640, "minHeight": 480, "decorations": false, "resizable": true, "visible": false, "dragDropEnabled": false, "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required" },
      { "label": "notch", "url": "notch/index.html", "title": "Ledge", "width": 1, "height": 1, "x": 0, "y": 0, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "focus": false, "shadow": false, "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required" },
      { "label": "atelier", "create": false, "title": "Ledge · Atelier", "width": 1000, "height": 720, "minWidth": 480, "minHeight": 360, "decorations": false, "resizable": true, "visible": false, "dragDropEnabled": false, "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required" }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:47831", "devCsp": null }
  },
  "bundle": {
    "active": true, "createUpdaterArtifacts": true, "targets": ["nsis"],
    "windows": { "nsis": { "installMode": "currentUser", "installerHooks": "windows/hooks.nsh" } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": { "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2M0NDQ0YzRDAxMzM2QUQKUldTdE5oUFE4OHc4ZGdHSHlOUVVCemdoSUlxanArMitsWng2cEZSNWx4bXMxTjg0RWlNUnJ0REQK", "endpoints": ["https://github.com/Lyssaen/ledge/releases/latest/download/latest-desktop.json"], "windows": { "installMode": "passive" } }
  }
}
