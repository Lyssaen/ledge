{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "atelier",
  "description": "The detached Atelier (#21): the daemon's events, sending what it opens to the main window, closing itself (« Rattacher »), its focus, its own window bar (#30: minimise, maximise, restore, drag), full screen (#41) and the webview zoom (UI scale).",
  "windows": ["atelier"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:webview:allow-set-webview-zoom"
  ]
}
