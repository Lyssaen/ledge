{
  "name": "desktop",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/notch.mjs build && node scripts/copy-notch.mjs",
    "dev:notch": "node scripts/notch.mjs dev",
    "dev:all": "pnpm --parallel --filter desktop run \"/^dev(:notch)?$/\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "e2e": "playwright test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ledge/fleet": "workspace:*",
    "@ledge/protocol": "workspace:*",
    "@ledge/ui": "workspace:*",
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12",
    "ws": "^8.18.0"
  }
}
