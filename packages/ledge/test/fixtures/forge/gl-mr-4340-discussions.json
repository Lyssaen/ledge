 {
  "id": "2b7fc79776172e954ed2ce074ecb5d4e8e7d5458",
  "individual_note": false,
  "resolvable": true,
  "resolved": false,
  "notes": [
   {
    "id": 4185658933,
    "type": "DiffNote",
    "body": "This JSON test substring-matches the raw output (lines 331-334). The project test rules say to `json.Unmarshal` into a typed struct and assert on fields. A substring check cannot tell which milestone carries `group_id` or `project_id`. It also breaks if the encoder changes spacing or field order. Unmarshal into `[]gitlab.GroupMilestone`, then assert `GroupID`, `ProjectID` and `Title` per element. The older `TestMilestoneList_JSON` does the same substring match, but new tests should not copy it.",
    "author": {
     "id": 21826781,
     "username": "GitLabDuo",
     "state": "active",
     "locked": false,
