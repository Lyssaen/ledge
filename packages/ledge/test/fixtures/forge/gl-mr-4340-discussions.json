 {
  "id": "6ac7ce837a42afdbe033e1b012278ef1dcfece64",
  "individual_note": false,
  "resolvable": true,
  "resolved": false,
  "notes": [
   {
    "id": 4185658890,
    "type": "DiffNote",
    "body": "The `|| o.includeDescendants` term never changes the result. The flag defaults to false, so `o.includeDescendants` can only be true after cobra parses `--include-descendants`, and then `Changed` is already true. The `--include-ancestors` check just above uses `Changed` alone. Match it so the next reader does not hunt for a second way the field can be set.\n```suggestion:-0+0\n\t\tif cmd.Flags().Changed(\"include-descendants\") {\n```",
    "author": {
     "id": 21826781,
     "username": "GitLabDuo",
     "state": "active",
     "locked": false,
     "web_url": "https://gitlab.com/GitLabDuo"
    },
